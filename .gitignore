############################################
# Unity generated folders
############################################
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/

# Asset Store tools cache (sometimes)
[Uu]serSettings/

############################################
# Unity generated files
############################################
# Autogenerated VS/MonoDevelop solution and project files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# Unity3D generated meta files for non-assets (rare)
*.pidb.meta
*.pdb.meta

# Unity crash reports / performance reports
sysinfo.txt

############################################
# Builds / packaged outputs
############################################
*.apk
*.aab
*.ipa
*.app
*.exe
*.x86
*.x86_64
*.data
*.obb
*.unitypackage

# Addressables build outputs (often safe to ignore)
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.json
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.hash
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.catalog
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bundle

############################################
# IDE / Editor folders and files
############################################
# Visual Studio cache/options directory
.vs/
# VS Code
.vscode/
# JetBrains Rider / IntelliJ
.idea/
# Rider plugin for Unity (can regenerate)
[Rr]ider/
# MonoDevelop
.mono/

############################################
# OS generated files
############################################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

############################################
# Misc
############################################
# Gradle (Android) caches
.gradle/

# Temporary files
*.log

############################################
# If you use IL2CPP or auto-generated stuff
############################################
# These can be generated depending on platform; keep ignored unless you know you need them
# [Uu]nity[Bb]uild/  (example - usually not present)
